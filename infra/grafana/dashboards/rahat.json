  {
   "id": 8,
   "title": "Traffic: SOS accepted vs refused at the door",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "expr": "sum by (channel) (rate(rahat_sos_received_total[1m]))*60",
     "legendFormat": "accepted {{channel}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "sum by (reason) (rate(rahat_sos_rejected_total[1m]))*60",
     "legendFormat": "refused {{reason}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqpm",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {}
  },
