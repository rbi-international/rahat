# Copy to .env and fill in. .env is git-ignored. Never commit keys.

# ---- Which lane serves the agents -------------------------------------------
# fake    offline, deterministic, no key (default, used by CI)
# groq    free, console.groq.com/keys
# nvidia  free, build.nvidia.com (40 requests per minute)
# local   Ollama on your machine
# foundry Microsoft Foundry (paid)
PROVIDER=fake
FALLBACK_PROVIDER=

# Free lanes
GROQ_API_KEY=
NVIDIA_API_KEY=

# Microsoft Foundry. Paste the endpoint the portal shows; it is normalised to /openai/v1/.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Set to 1 in Azure Container Apps to use the managed identity instead of a key.
AZURE_USE_MANAGED_IDENTITY=0
# Deployment names (Foundry) or model names (other lanes). Blank uses the lane default.
MODEL_FAST=
MODEL_STRONG=
# Reasoning models only (gpt-5 family, gpt-oss). minimal | low | medium | high
REASONING_FAST=
REASONING_STRONG=

# Optional: Azure AI Content Safety, Prompt Shields
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# Optional: Azure Monitor tracing
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- The organisation's token allocation (the real spend cap) ---------------
ORG_NAME=Neerdhara Systems
ALLOCATION_TOKENS=1500000
LOW_BUDGET_RATIO=0.10
PRICE_INR_PER_M_TOKENS=60

# ---- Access -----------------------------------------------------------------
ADMIN_TOKEN=change-me-to-a-long-random-string
METRICS_TOKEN=
SESSION_MINUTES=90
SOS_COOLDOWN_S=20
SOS_MAX_PER_DEVICE=6
PUBLIC_BASE_URL=

# ---- Capacity ---------------------------------------------------------------
WORKERS=16
QUEUE_MAX=800
